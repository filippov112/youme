<UserControl x:Class="Pdp.UI.Controls.Editor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pdp.UI.Controls"
             xmlns:other="clr-namespace:Pdp.UI.Other"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <avalon:TextEditor x:Name="editorAvalon"
             other:TextEditorHelper.BoundText="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             FontFamily="Consolas"
             FontSize="10pt"
             ShowLineNumbers="True"
             other:TextEditorHelper.BoundHighlight="{Binding Highlight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         >
            <avalon:TextEditor.InputBindings>
                <KeyBinding Key="S" 
                            Modifiers="Control" 
                            Command="{Binding SaveCommand}" />
            </avalon:TextEditor.InputBindings>
        </avalon:TextEditor>
    </Grid>
</UserControl>
