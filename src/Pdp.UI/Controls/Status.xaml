<UserControl x:Class="Pdp.UI.Controls.Status"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pdp.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StatusBar>
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0" >
                <StatusBarItem.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenLoggerCommand}"/>
                </StatusBarItem.InputBindings>

                <Label Content="{Binding LastLogMessage}"/>
            </StatusBarItem>

            <Separator  Grid.Column="1"/>

            <StatusBarItem  Grid.Column="2">
                <Label Content="{Binding CurrentProcessName}"/>
            </StatusBarItem>

            <StatusBarItem  Grid.Column="3">
                <ProgressBar Width="100"/>
            </StatusBarItem>

        </StatusBar>
    </Grid>
</UserControl>
