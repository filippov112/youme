<UserControl x:Class="Pdp.UI.Controls.Templates"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pdp.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TabControl>
            <TabItem Header="Общие шаблоны">
                <ListBox ItemsSource="{Binding GlobalTemplates}">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Удалить"
    Command="{Binding DeleteCommand}"
    CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Переименовать"
    Command="{Binding RenameCommand}"
    CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            
                            <Border Background="Transparent" Padding="5">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" 
                                        Command="{Binding DataContext.ApplyTemplate, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                        CommandParameter="{Binding Query}" />
                                </Border.InputBindings>

                                <TextBlock Text="{Binding Name}" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem Header="Проект">
                <ListBox ItemsSource="{Binding LocalTemplates}">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Удалить"
Command="{Binding DeleteCommand}"
CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Переименовать"
Command="{Binding RenameCommand}"
CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border Background="Transparent" Padding="5">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" 
                                    Command="{Binding DataContext.ApplyTemplate, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                    CommandParameter="{Binding Query}" />
                                </Border.InputBindings>

                                <TextBlock Text="{Binding Name}" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>    
    </Grid>
</UserControl>
