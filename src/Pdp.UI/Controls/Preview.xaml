<UserControl x:Class="Pdp.UI.Controls.Preview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:other="clr-namespace:Pdp.UI.Other"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:local="clr-namespace:Pdp.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <avalon:TextEditor x:Name="editorAvalon"
            other:TextEditorHelper.BoundText="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            FontFamily="Consolas"
            FontSize="10pt"
            ShowLineNumbers="True"
            IsReadOnly="True"
            WordWrap="True"
            other:TextEditorHelper.BoundHighlight="Markdown"
        />

        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,25,5" Background="#7FEAEAEA">
            <Label Content="Всего токенов:" Padding="3,3,3,3"/>
            <Label Content="{Binding Tokens}" Padding="3,3,3,3"/>
        </StackPanel>


        <GridSplitter Grid.Column="1" Width="5" />

        <ListBox ItemsSource="{Binding Sectors}" Grid.Column="2">
            <ListBox.ItemTemplate>
                <DataTemplate>

                    <Border Background="Transparent" Padding="5">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" 
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                    CommandParameter="{Binding Position}" />
                        </Border.InputBindings>

                        <TextBlock Text="{Binding Name}" />
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</UserControl>
