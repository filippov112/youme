<Window x:Class="Pdp.UI.Windows.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pdp.UI.Windows"
        mc:Ignorable="d"
        Title="Журнал" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0" ToolBarTray.IsLocked="True">
            <Button Content="Очистить текущий сеанс" Command="{Binding ClearSessionCommand}"/>
            <Separator/>
            <Button Content="Очистить БД" Command="{Binding ClearDBCommand}"/>
            <Separator/>
            <CheckBox Content="Автопрокрутка" IsChecked="{Binding AutoScroll}"/>
        </ToolBar>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
            <Label Content="Начало периода:" VerticalAlignment="Center"/>
            <DatePicker SelectedDate="{Binding BeginDate}" Margin="5,0" VerticalAlignment="Center"/>
            <Label Content="Конец периода:" VerticalAlignment="Center"/>
            <DatePicker x:Name="EndDatePicker" SelectedDate="{Binding EndDate}" Margin="5,0" VerticalAlignment="Center"/>
            <Button x:Name="LoadFromDatabaseButton" Content="Загрузить из БД" Command="{Binding LoadFromDBCommand}" Margin="5,0" VerticalAlignment="Center" Padding="3,3,3,3"/>
        </StackPanel>

        <DataGrid x:Name="LogsDataGrid" Grid.Row="2" 
                  ItemsSource="{Binding LogMessages}" 
                  AutoGenerateColumns="False"
                  AlternatingRowBackground="LightGray"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Время" Binding="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Отправитель" Binding="{Binding Sender}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Сеанс" Binding="{Binding SessionId, StringFormat='dd.MM.yyyy HH:mm:ss'}" Width="120" IsReadOnly="True"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Type}" Value="Error">
                            <Setter Property="Background" Value="LightCoral"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="Warning">
                            <Setter Property="Background" Value="LightYellow"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="Debug">
                            <Setter Property="Background" Value="LightBlue"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</Window>
