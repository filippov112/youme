<UserControl x:Class="Presentation.Controls.Editor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Presentation.Controls"
             xmlns:other="clr-namespace:Presentation.Other"
             
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d">
    <Grid>
        <avalon:TextEditor x:Name="editorAvalon"
            other:TextEditorHelper.BoundText="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            FontFamily="Consolas"
            FontSize="10pt"
            ShowLineNumbers="True"
            other:TextEditorHelper.BoundHighlight="{Binding Highlight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        />
    </Grid>
</UserControl>
