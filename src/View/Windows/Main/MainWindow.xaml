<Window x:Class="View.Windows.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:explorer="clr-namespace:View.Windows.Main.Explorer" 
        xmlns:editor="clr-namespace:View.Windows.Main.Editor" 
        xmlns:selection="clr-namespace:View.Windows.Main.Selections.Models"
        xmlns:vm="clr-namespace:View.Windows.Main"
        mc:Ignorable="d"
        Title="Project Studio"
        Height="700"
        Width="1300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Menu x:Name="Menu">
            <MenuItem x:Name="btnOpen"
                    Header="Открыть проект"
                    Command="{Binding OpenProjectCommand}" Padding="6,4,6,4"/>
            <MenuItem x:Name="btnSettings"
                    Header="Настройки"
                    Command="{Binding OpenSettingsCommand}" Padding="6,4,6,4"/>

            <!-- Последние проекты -->
            <MenuItem Header="Последние проекты" 
                          ItemsSource="{Binding RecentProjectsViewModel.RecentProjects}">

                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding ProjectName}" />
                        <Setter Property="ToolTip" Value="{Binding ProjectPath}" />
                        <Setter Property="Command" 
                                    Value="{Binding DataContext.RecentProjectsViewModel.OpenProjectCommand, 
                                    RelativeSource={RelativeSource AncestorType=Menu}}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>

            <MenuItem
                Header="Выборки"
                Command="{Binding OpenSelectionsCommand}" Padding="6,4,6,4"/>

            <MenuItem
                Header="Компоновки сборки"
                Command="{Binding OpenLayoutsCommand}" Padding="6,4,6,4"/>

            <MenuItem
                Header="Файловые компоненты"
                Command="{Binding OpenFileComponentsCommand}" Padding="6,4,6,4"/>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <!-- Левая панель Проводник -->
            <Grid Grid.RowSpan="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0.5*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <explorer:ExplorerControl DataContext="{Binding ExplorerViewModel}"/>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"></GridSplitter>

                <TabControl Grid.Row="2">
                    
                    <TabItem Header="Выборки">
                        <ListBox ItemsSource="{Binding Selections}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding SelectCommand}" Padding="3,3,3,3" HorizontalContentAlignment="Left">
                                        <Label Content="{Binding Name}" HorizontalAlignment="Left" FontSize="14"/>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    
                    <TabItem Header="Компоновки">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Orientation="Horizontal" Margin="4,4,4,4">
                                <CheckBox Content="Общие" IsChecked="{Binding CommonLayoutsVisible}"/>
                                <CheckBox Content="Проектные" IsChecked="{Binding ProjectLayoutsVisible}" Margin="6,0,0,0"/>
                            </StackPanel>
                            
                            <ListBox ItemsSource="{Binding Layouts}" Grid.Row="1" SelectedItem="{Binding SelectedLayout}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Label Content="{Binding Name}" HorizontalAlignment="Left" FontSize="14"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        
                    </TabItem>
                    
                </TabControl>
                
                <StackPanel Grid.Row="3">
                    <StackPanel.Background>
                        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
                    </StackPanel.Background>
                    <Button Margin="5"
                        Command="{Binding PasteDocsCommand}"
                        Background="#FFC0FFC7" Padding="15,5,15,5" FontWeight="Bold" FontSize="14">Создать документацию</Button>
                </StackPanel>
            </Grid>


            <GridSplitter Grid.RowSpan="3" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

            <!-- Область просмотра/редактирования -->
            <editor:EditorControl DataContext="{Binding EditorViewModel}" Grid.Column="2"/>

            <GridSplitter Grid.Row="1" Height="5" Grid.ColumnSpan="1" HorizontalAlignment="Stretch" Grid.Column="2" />

            <!-- Область ввода запроса -->
            <Grid Grid.Row="2" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.Background>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
                </Grid.Background>
                <Label Content="Запрос / Заполненная структура:" VerticalAlignment="Top" Margin="15,0,0,0"/>

                <!-- Запрос -->
                <TextBox
                    x:Name="txtMessage"
                    Text="{Binding Query}"
                    TextWrapping="Wrap"
                    AllowDrop="True"
                    Drop="TextBox_Drop"
                    AutoWordSelection="True"
                    AcceptsTab="True"
                    AcceptsReturn="True" 
                    Padding="6,4,6,4" Grid.Row="1"/>

                <!-- Копировать -->
                <Button x:Name="btnContext"
                    Content="Контекст"
                    Command="{Binding BuildContextCommand}"
                    Background="#FFC0FFC7" Padding="15,5,15,5" FontWeight="Bold" FontSize="14"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                    Margin="0,0,10,10" Grid.Row="1"/>

                <Button x:Name="btnStruct"
                    Content="Структура"
                    Command="{Binding BuildStructCommand}"
                    Background="#FFC0FFC7" Padding="15,5,15,5" FontWeight="Bold" FontSize="14"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                    Margin="0,0,131,10" Grid.Row="1"/>

                <!-- Сумма токенов-->
                <Grid
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom" Margin="10,0,0,10" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Примерное число токенов:" FontSize="14" FontWeight="Bold"/>
                    <Label x:Name="lWordCounter"
                        Content="{Binding Tokens}"
                        Grid.Column="1" FontSize="16" Foreground="#FF3C6CE2" FontWeight="Bold"/>
                </Grid>

            </Grid>
        </Grid>

    </Grid>
</Window>
