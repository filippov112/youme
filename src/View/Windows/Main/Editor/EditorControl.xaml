<UserControl x:Class="View.Windows.Main.Editor.EditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:View.Windows.Main.Editor"
             xmlns:services="clr-namespace:View.Windows.Main.Editor.Services"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <avalon:TextEditor x:Name="editorAvalon"
            services:TextEditorHelper.BoundText="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            FontFamily="Consolas"
            FontSize="10pt"
            ShowLineNumbers="True"
            services:TextEditorHelper.BoundHighlight="{Binding Highlight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        />    
    </Grid>
</UserControl>
