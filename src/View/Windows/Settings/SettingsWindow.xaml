<Window x:Class="View.Windows.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:View.Windows.Settings"
        xmlns:cv="clr-namespace:View.Converters"
        mc:Ignorable="d"
        Title="Настройки" 
        Height="600" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель с меню -->
        <Grid Grid.Column="0" Background="#F5F5F5">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Кнопки меню -->
            <StackPanel Margin="0,20,0,0">
                <Button Content="🌐 Глобальная конфигурация"
                        Style="{Binding IsGlobalSelected}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="Global" Padding="1,5,1,5" Margin="5,0,5,5"/>

                <Button Content="📁 Проектная конфигурация"
                        Style="{Binding IsLocalSelected}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="Local"
                        IsEnabled="{Binding IsLocalEnabled}" Padding="1,5,1,5" Margin="5,0,5,5"/>
            </StackPanel>
            
            <!-- Кнопки действий -->
            <StackPanel Grid.Row="1">
                <Separator Margin="20,10" Background="#DDDDDD"/>

                <Button Content="💾 Сохранить"
            Command="{Binding SaveCommand}"
            Margin="5,5,5,5"
            FontWeight="Bold"
            Padding="15,5,15,5"/>

                <Button Content="🔄 Сбросить к заводским настройкам"
            Command="{Binding ResetToDefaultCommand}"
            Margin="5,5,5,5" Padding="1,5,1,5"/>

                <Button Content="❌ Отмена"
            Command="{Binding CancelCommand}"
            Margin="5,5,5,5" Padding="1,5,1,5"/>
            </StackPanel>
        </Grid>

        <!-- Правая панель с содержимым -->
        <Grid Grid.Column="1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                      Text="{Binding CurrentTabTitle}" 
                      FontSize="18" 
                      FontWeight="Bold" 
                      Foreground="#333333" Padding="10,6,10,6">
                <TextBlock.Background>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
                </TextBlock.Background>
            </TextBlock>

            <!-- Глобальная конфигурация -->
            <ScrollViewer Grid.Row="1" 
                         Visibility="{Binding IsGlobalSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="5,5,5,5">
                <StackPanel>

                    <GroupBox Header="Инициализация проекта" Margin="0,0,0,15">
                        <Grid>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Каталог-шаблон документации:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding GlobalConfig.DocsTemplate, UpdateSourceTrigger=PropertyChanged}" 
                        Margin="0,0,0,10"/>
                            </StackPanel>
                        </Grid>
                        
                    </GroupBox>

                    <GroupBox Header="Ключи замены" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Ключ введения:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding GlobalConfig.IntroductionKey, UpdateSourceTrigger=PropertyChanged}" 
                                        Margin="0,0,0,10"/>

                                <TextBlock Text="Ключ контекста:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding GlobalConfig.ContextKey, UpdateSourceTrigger=PropertyChanged}" 
                                        Margin="0,0,0,10"/>

                                <TextBlock Text="Ключ правил:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding GlobalConfig.RulesKey, UpdateSourceTrigger=PropertyChanged}" 
                                        Margin="0,0,0,10"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Ключ запроса:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding GlobalConfig.QueryKey, UpdateSourceTrigger=PropertyChanged}" 
                                        Margin="0,0,0,10"/>

                                <TextBlock Text="Ключ пути файла:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding GlobalConfig.FilePathKey, UpdateSourceTrigger=PropertyChanged}" 
                                        Margin="0,0,0,10"/>

                                <TextBlock Text="Ключ содержимого файла:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding GlobalConfig.FileContentKey, UpdateSourceTrigger=PropertyChanged}" 
                                        Margin="0,0,0,10"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Структуры" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Структура промпта:" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding GlobalConfig.PromptStructure, UpdateSourceTrigger=PropertyChanged}" 
                                    Height="200" TextWrapping="Wrap" AcceptsReturn="True" 
                                    VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                            <TextBlock Text="Структура файла:" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding GlobalConfig.FileStructure, UpdateSourceTrigger=PropertyChanged}" 
                                    Height="200" TextWrapping="Wrap" AcceptsReturn="True" 
                                    VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Значения по умолчанию" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Текст введения:" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding GlobalConfig.IntroductionText, UpdateSourceTrigger=PropertyChanged}" 
                                    Height="200" TextWrapping="Wrap" AcceptsReturn="True" 
                                    VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                            <TextBlock Text="Текст правил:" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding GlobalConfig.RulesText, UpdateSourceTrigger=PropertyChanged}" 
                                    Height="200" TextWrapping="Wrap" AcceptsReturn="True" 
                                    VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Проектная конфигурация -->
            <ScrollViewer Grid.Row="1" 
                         Visibility="{Binding IsLocalSelected, Converter={StaticResource BooleanToVisibilityConverter}}" d:IsHidden="True">
                <StackPanel>
                    <GroupBox Header="Ключи замены" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Ключ введения:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding LocalConfig.IntroductionKey, UpdateSourceTrigger=PropertyChanged}" 
                                        Margin="0,0,0,10"/>

                                <TextBlock Text="Ключ контекста:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding LocalConfig.ContextKey, UpdateSourceTrigger=PropertyChanged}" 
                                        Margin="0,0,0,10"/>

                                <TextBlock Text="Ключ правил:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding LocalConfig.RulesKey, UpdateSourceTrigger=PropertyChanged}" 
                                        Margin="0,0,0,10"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Ключ запроса:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding LocalConfig.QueryKey, UpdateSourceTrigger=PropertyChanged}" 
                                        Margin="0,0,0,10"/>

                                <TextBlock Text="Ключ пути файла:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding LocalConfig.FilePathKey, UpdateSourceTrigger=PropertyChanged}" 
                                        Margin="0,0,0,10"/>

                                <TextBlock Text="Ключ содержимого файла:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding LocalConfig.FileContentKey, UpdateSourceTrigger=PropertyChanged}" 
                                        Margin="0,0,0,10"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Структуры" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Структура промпта:" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding LocalConfig.PromptStructure, UpdateSourceTrigger=PropertyChanged}" 
                                    Height="200" TextWrapping="Wrap" AcceptsReturn="True" 
                                    VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                            <TextBlock Text="Структура файла:" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding LocalConfig.FileStructure, UpdateSourceTrigger=PropertyChanged}" 
                                    Height="200" TextWrapping="Wrap" AcceptsReturn="True" 
                                    VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Значения по умолчанию" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Текст введения:" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding LocalConfig.IntroductionText, UpdateSourceTrigger=PropertyChanged}" 
                                    Height="60" TextWrapping="Wrap" AcceptsReturn="True" 
                                    VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                            <TextBlock Text="Текст правил:" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding LocalConfig.RulesText, UpdateSourceTrigger=PropertyChanged}" 
                                    Height="60" TextWrapping="Wrap" AcceptsReturn="True" 
                                    VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>