<Window x:Class="View.Windows.FileComponents.FileComponentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View.Windows.FileComponents"
        mc:Ignorable="d"
        Title="Файловые компоненты" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Grid>
            <Grid.Background>
                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlLightColorKey}}"/>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label>Действующие компоненты:</Label>

            <ListBox Grid.Row="1" ItemsSource="{Binding Components}" SelectedItem="{Binding SelectedComponent}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Label Content="{Binding Name}" FontSize="14" FontWeight="Bold" Padding="5,2,5,0"/>
                                <Label Content="{Binding Key}" FontSize="14" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" Padding="0,0,15,0"/>
                                <Label Content="{Binding Path}" FontSize="9" Grid.Row="1" Padding="5,1,5,2"/>
                            </Grid>
                            <Separator/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="2">
                    <Label Padding="5,5,5,1">Название:</Label>
                    <TextBox Grid.Row="1" Grid.ColumnSpan="2" Padding="4,4,4,4" Margin="2,2,2,1" Text="{Binding CurrentName}"/>
                    <Label Padding="5,5,5,1">Файл:</Label>
                    <TextBox Grid.Row="1" Grid.ColumnSpan="2" Padding="4,4,4,4" Margin="2,2,2,1" Text="{Binding CurrentPath}" IsEnabled="False"/>
                    <Label Padding="5,5,5,1">Ключ замены:</Label>
                    <TextBox Grid.Row="1" Grid.ColumnSpan="2" Padding="4,4,4,4" Margin="2,2,2,1" Text="{Binding CurrentKey}"/>
                </StackPanel>
                <Button Grid.Row="2" Grid.ColumnSpan="2" Padding="4,4,4,4" Margin="2,1,2,1" Command="{Binding UpdateComponentCommand}">Обновить</Button>
                <Button Grid.Row="3" Padding="4,4,4,4" Margin="2,1,2,2" Command="{Binding CreateComponentCommand}">Создать</Button>
                <Button Grid.Row="3" Grid.Column="1" Padding="4,4,4,4" Margin="2,1,2,2" Command="{Binding DeleteComponentCommand}">Удалить</Button>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch">
            <GridSplitter.Background>
                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveBorderColorKey}}"/>
            </GridSplitter.Background>
        </GridSplitter>

        <!-- Правая панель -->
        <Grid Grid.Column="2">
            <Grid.Background>
                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlLightColorKey}}"/>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Label>Файлы проекта:</Label>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchPattern}" VerticalContentAlignment="Center" />
                    <Button Command="{Binding SearchFilesCommand}" Content="Найти" Grid.Column="1" Padding="4,4,4,4"/>
                </Grid>
                <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFilePath}" Grid.Row="1"></ListBox>
            </Grid>

        </Grid>

        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Grid.Row="1" Grid.ColumnSpan="5">
            <Button Padding="6" Margin="8" Background="#FFBDFD74" Command="{Binding SaveCommand}">Сохранить</Button>
        </StackPanel>
    </Grid>
</Window>
