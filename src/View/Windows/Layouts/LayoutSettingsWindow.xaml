<Window x:Class="View.Windows.Layouts.LayoutSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View.Windows.Layouts"
        mc:Ignorable="d"
        Title="Компоновки" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Grid>
            <Grid.Background>
                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlLightColorKey}}"/>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl SelectedIndex="{Binding ActiveLayoutTabIndex}">
                <!-- Общие компоновки -->
                <TabItem Header="Общие">
                    <Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding CommonLayouts}" SelectedItem="{Binding SelectedLayout}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Label Content="{Binding Name}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <!-- Проектные компоновки -->
                <TabItem Header="Проектные">
                    <Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding ProjectLayouts}" SelectedItem="{Binding SelectedLayout}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Label Content="{Binding Name}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="2">
                    <Label Padding="5,5,5,1">Название:</Label>
                    <TextBox Grid.Row="1" Grid.ColumnSpan="2" Padding="4,4,4,4" Margin="2,2,2,1" Text="{Binding CurrentLayoutName}"/>
                </StackPanel>
                <Button Grid.Row="2" Padding="4,4,4,4" Margin="2,1,2,2" Command="{Binding CreateCommonLayoutCommand}">Создать общую</Button>
                <Button Grid.Row="2" Grid.Column="1" Padding="4,4,4,4" Margin="2,1,2,2" Command="{Binding CreateProjectLayoutCommand}">Создать проектную</Button>
                <Button Grid.Row="3" Padding="4,4,4,4" Margin="2,1,2,2" Command="{Binding UpdateLayoutCommand}">Обновить</Button>
                <Button Grid.Row="3" Grid.Column="1" Padding="4,4,4,4" Margin="2,1,2,2" Command="{Binding DeleteLayoutCommand}">Удалить</Button>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch">
            <GridSplitter.Background>
                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveBorderColorKey}}"/>
            </GridSplitter.Background>
        </GridSplitter>
        
        <!-- Центральная панель -->
        <Grid Grid.Column="2">
            <Grid.Background>
                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlLightColorKey}}"/>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Label Content="Структура промпта:" Padding="5,5,5,1"/>
            <TextBox TextWrapping="Wrap" AcceptsReturn="True"  Grid.Row="1" Text="{Binding CurrentLayoutStructure}"/>
        </Grid>

        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch">
            <GridSplitter.Background>
                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ActiveBorderColorKey}}"/>
            </GridSplitter.Background>
        </GridSplitter>

        <!-- Правая панель -->
        <Grid Grid.Column="4">
            <Grid.Background>
                <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlLightColorKey}}"/>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <StackPanel Margin="3,0,3,0">
                <Label Padding="5,5,5,1">Контекст:</Label>
                <TextBox Text="{Binding ContextKey}" IsEnabled="False"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="3,0,3,3">
                <Label Padding="5,3,5,1">Запрос:</Label>
                <TextBox Text="{Binding QueryKey}" IsEnabled="False"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Label Padding="5,5,5,1">Файловые компоненты:</Label>
                <ListBox ItemsSource="{Binding Components}" Focusable="False" IsEnabled="False" Grid.Row="1">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Content="{Binding Name}" Background="#FFECECEC"/>
                                <Label Grid.Column="1" Content="{Binding Key}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            
        </Grid>

        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Grid.Row="1" Grid.ColumnSpan="5">
            <Button Padding="6" Margin="8" Background="#FFBDFD74" Command="{Binding SaveCommand}">Сохранить</Button>
        </StackPanel>
    </Grid>
</Window>
